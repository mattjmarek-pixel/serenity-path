{
  "name": "serenity-path",
  "main": "client/index.js",
  "version": "1.0.0",
  "scripts": {
    "expo:dev": "node scripts/expo-login.cjs && EXPO_PACKAGER_PROXY_URL=https://${EXPO_PACKAGER_PROXY_URL_HOST:-$REPLIT_DEV_DOMAIN} REACT_NATIVE_PACKAGER_HOSTNAME=${REACT_NATIVE_PACKAGER_HOSTNAME:-$REPLIT_DEV_DOMAIN} EXPO_PUBLIC_DOMAIN=${EXPO_PUBLIC_DOMAIN:-$REPLIT_DEV_DOMAIN:5000} npx expo start --localhost",
    "expo:dev:local": "EXPO_PUBLIC_DOMAIN=${EXPO_PUBLIC_DOMAIN:-localhost:5000} npx expo start --localhost",
    "server:dev": "NODE_ENV=development tsx server/index.ts",
    "all:dev": "npm run expo:dev & npm run server:dev",
    "expo:start:static:build": "EXPO_PUBLIC_DOMAIN=${EXPO_PUBLIC_DOMAIN:-$REPLIT_INTERNAL_APP_DOMAIN} npx expo start --no-dev --minify --localhost",
    "expo:static:build": "node scripts/build.js",
    "server:build": "esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=server_dist",
    "server:prod": "NODE_ENV=production node server_dist/index.js",
    "db:push": "drizzle-kit push",
    "lint": "npx expo lint",
    "lint:fix": "npx expo lint --fix",
    "check:types": "tsc --noEmit",
    "check:format": "prettier --check \"client/**/*.{js,ts,tsx,json}\" \"server/**/*.{js,ts,json}\" \"shared/**/*.{ts,json}\" \"*.{json,md}\"",
    "format": "prettier --write \"client/**/*.{js,ts,tsx,json}\" \"server/**/*.{js,ts,json}\" \"shared/**/*.{ts,json}\" \"*.{json,md}\"",
    "test": "jest"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/client/__tests__"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.cache/",
      "<rootDir>/server_dist/",
      "<rootDir>/static-build/"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "babel-jest",
        {
          "presets": [
            "babel-preset-expo"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "@expo-google-fonts/crimson-pro": "^0.4.2",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/config-plugins": "~57.0.10",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-picker/picker": "2.11.4",
    "@react-native/js-polyfills": "^0.81.5",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.16",
    "@tanstack/react-query": "^5.90.7",
    "babel-preset-expo": "~57.0.0",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "expo": "^57.0.23",
    "expo-apple-authentication": "~57.0.2",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.12",
    "expo-location": "~57.0.21",
    "expo-notifications": "~57.0.22",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "http-proxy-middleware": "^3.0.5",
    "pg": "^8.16.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-purchases": "^10.13.0",
    "react-native-purchases-ui": "^10.13.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "react-test-renderer": "^19.2.3",
    "tsx": "^4.20.6",
    "ws": "^8.18.0",
    "zod": "^3.24.2",
    "zod-validation-error": "^4.0.2"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.2.0",
    "@types/express": "^4.17.21",
    "@types/jest": "29.5.14",
    "@types/node": "24.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "~19.2.4",
    "babel-plugin-module-resolver": "^5.0.2",
    "create-launch": "0.4.1",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-node": "^0.3.9",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "prettier": "3.6.2",
    "typescript": "~6.0.3"
  },
  "private": true
}
